{
  // BOT-1.3 (D-62): cấu hình KHÔNG bí mật của container messaging. Bí mật chỉ ở env / user-secrets:
  //   Messaging__ClientKey (khóa client – api giữ SHA-256 ở Clients__MESSAGING__KeyHash),
  //   Telegram__Bots__VH__Token, Telegram__Bots__VH__WebhookSecret, Telegram__Bots__DH__Token, Telegram__Bots__DH__WebhookSecret.
  // KHÔNG có chuỗi kết nối DB – messaging không chạm DB.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "ApiBaseUrl": "http://localhost:5125",
    "Mode": "Polling",
    "WebhookBaseUrl": "",
    "InboundScanSeconds": 5,
    "OutboundScanSeconds": 2,
    "IdentityCacheSeconds": 30,
    // BOT-2.2 / 2.3: chu kỳ gọi api leo thang sự việc / kiểm tra định kỳ (giây; 0 = tắt). Ngưỡng phút ở api (Messaging:Watch, Messaging:Escalation).
    "EscalationIntervalSeconds": 60,
    "WatchIntervalSeconds": 300,
    // BOT-2.4 (PROPOSED): bán kính (m) nhận biết tài xế vào điểm giao / rời bếp khi chia sẻ vị trí trực tiếp.
    "LiveLocation": { "RadiusMeters": 150 },
    // BOT-UX-1: bảng điều khiển duy nhất ở chat riêng (Enabled = false → mỗi màn 1 tin như cũ). Telegram chỉ cho xóa tin trong 48 giờ.
    "Panel": { "Enabled": true, "DeleteWithinHours": 48, "RecentCount": 4 },
    // BOT-UX-2 (mục 7): lý do / ghi chú hay gặp của từng luồng = nút bấm (tối đa 8 / luồng), cuối luôn có [✏️ Khác…] để gõ tay.
    // Bỏ trống 1 luồng → dùng danh sách mặc định trong code (Experience/ReasonCatalog). Nút mang số thứ tự – đổi thứ tự khi đang có người bấm dở thì lý do có thể lệch.
    "Reasons": {
      "apv-reject": [ "Thiếu thông tin / chứng từ", "Sai số liệu – lập lại", "Chưa đúng quy định", "Không bố trí được – chọn thời gian khác" ],
      "bat-fix": [ "Gia nhiệt lại 10 phút, đo lại", "Kéo dài thời gian nấu, đo lại", "Chia nhỏ mẻ, nấu lại", "Giữ mẻ, báo QC xử lý" ],
      "bat-exr": [ "Khách đặt thêm suất", "Mẻ trước hỏng / không đạt", "Bù suất giao thiếu", "Hao hụt khi chia suất" ],
      "dlv-fail": [ "Khách không nhận hàng", "Không liên lạc được người nhận", "Sai / không tìm thấy địa chỉ", "Xe hỏng / trễ quá giờ" ],
      "hr-proxy": [ "Quên điện thoại", "Điện thoại hết pin / hỏng", "Không định vị được", "Làm việc ngoài điểm" ],
      "leave-reason": [ "Việc gia đình", "Ốm / khám bệnh", "Việc cá nhân", "Nghỉ phép năm theo kế hoạch" ],
      "swap-reason": [ "Việc gia đình", "Ốm / khám bệnh", "Trùng lịch học / việc riêng", "Đã thỏa thuận với đồng nghiệp" ],
      "op-change-reason": [ "Khách đề nghị", "Thiếu nguyên liệu", "Giá nguyên liệu tăng", "Món không hợp mùa" ],
      "op-clean-reject": [ "Còn bẩn / bám dầu", "Nhiệt độ rửa không đạt", "Hộp khay hỏng / nứt", "Thiếu hóa chất đúng quy định" ]
    }
  },
  "Telegram": {
    "ApiBaseUrl": "https://api.telegram.org",
    "PollingTimeoutSeconds": 25,
    "Bots": {
      "VH": { "Username": "", "Enabled": true },
      "DH": { "Username": "", "Enabled": true }
    }
  },
  "Sending": {
    "MaxPerSecond": 25,
    "PerChatPerSecond": 1,
    "BatchSize": 20,
    "UndoSeconds": 10
  }
}
