<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- BOT-1.3 (D-62): container messaging – TẤT CẢ bot (Telegram VH / DH; sau này Zalo, Facebook).
       KHÔNG ProjectReference nào (không Services / Data / Model), KHÔNG chuỗi kết nối DB, KHÔNG gói NuGet ngoài ASP.NET Core: mọi việc gọi api qua HTTP. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AppDelicare.Messaging</RootNamespace>
    <UserSecretsId>delicare-messaging-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AppDelicare.Tests" />
  </ItemGroup>

</Project>
