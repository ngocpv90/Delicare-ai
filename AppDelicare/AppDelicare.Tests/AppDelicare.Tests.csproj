<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.34" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.34" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- BOT-1.3: test container messaging (client Telegram giả + api giả). Cả 2 có appsettings.json – target KeepWebApiAppSettings bên dưới giữ bản của WebApi. -->
    <ProjectReference Include="..\AppDelicare.Messaging\AppDelicare.Messaging.csproj" />
    <ProjectReference Include="..\AppDelicare.WebApi\AppDelicare.WebApi.csproj" />
    <ProjectReference Include="..\AppDelicare.Data\AppDelicare.Data.csproj" />
    <ProjectReference Include="..\AppDelicare.Model\AppDelicare.Model.csproj" />
  </ItemGroup>

  <!-- BOT-1.3: AppDelicare.Messaging cũng có appsettings.json – luôn giữ bản của WebApi trong thư mục test (WebApplicationFactory / cấu hình test). -->
  <Target Name="KeepWebApiAppSettings" AfterTargets="Build">
    <Copy SourceFiles="..\AppDelicare.WebApi\appsettings.json" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
