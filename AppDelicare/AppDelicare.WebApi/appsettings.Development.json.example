// MẪU – chỉ chứa placeholder. KHÔNG ghi giá trị thật vào repo.
// Cách khuyến nghị (dev): dùng dotnet user-secrets thay vì file này:
//   cd AppDelicare/AppDelicare.WebApi
//   dotnet user-secrets set "Jwt:SigningKey" "<chuỗi ngẫu nhiên >= 32 byte>"
//   dotnet user-secrets set "ConnectionStrings:MainConnectionString" "Server=(localdb)\\MSSQLLocalDB;Database=AppDelicare;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true;"
//   dotnet user-secrets set "Licenses:GemBox" "<license GemBox>"
// Nếu vẫn muốn dùng file: sao chép thành appsettings.Development.json (đã .gitignore) rồi điền giá trị.
{
  "ConnectionStrings": {
    "MainConnectionString": "<CONNECTION_STRING_DB_DEV>"
  },
  "Jwt": {
    "SigningKey": "<RANDOM_SECRET_AT_LEAST_32_BYTES>",
    "AccessTokenMinutes": 120
  },
  "Licenses": {
    "GemBox": "<GEMBOX_LICENSE_OR_EMPTY>"
  },
  "ApplicationInsights": {
    "QuickPulseApiKey": "<OPTIONAL>"
  },
  // HR-ACC-1.6 (D-82 f): VÍ DỤ nhóm quyền gợi ý theo chức danh – đổi theo mã chức danh / tên nhóm thật của DB (không phải giá trị chốt).
  "BusinessRules": {
    "PositionDefaultGroups": {
      "BEP-TRUONG": "OPS-KIT",
      "TAI-XE": "OPS-LOG",
      "KE-TOAN": "FIN-ACC",
      "NHAN-SU": "FIN-HR"
    },
    "Hr": { "LegacyEmployeeMatch": true }
  }
}
