{
  "Serilog": {
    "Using": ["Serilog.Sinks.File", "Serilog.Sinks.Async"],
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level}] [{CorrelationId}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/AppDelicare.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] [{CorrelationId}] {Message}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EPPlus": {
    "ExcelPackage": {
      "LicenseContext": "Commercial" //The license context used
    }
  },
  "AllowedHosts": "*",
  // T03: origin được phép gọi API từ trình duyệt khi frontend khác domain. Angular dev dùng proxy nên không cần.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  // T01: KHÔNG ghi bí mật vào file này. Dev: dotnet user-secrets; prod: biến môi trường (Jwt__SigningKey...).
  // Xem appsettings.Development.json.example và docs/claude/SECRETS_TODO.md.
  "ConnectionStrings": {
    "MainConnectionString": "" // BẮT BUỘC – đặt trong user-secrets / biến môi trường
  },
  "JwtIssuerOptions": {
    "Issuer": "webApi",
    "Audience": "http://localhost:5125/"
  },
  "Jwt": {
    "SigningKey": "", // BẮT BUỘC – tối thiểu 32 byte, đặt trong user-secrets / biến môi trường
    "AccessTokenMinutes": 120
  },
  "Licenses": {
    "GemBox": "" // tùy chọn – trống thì GemBox chạy FREE-LIMITED
  },
  // T10: quy tắc nghiệp vụ (BUSINESS_RULES.md) – đổi ngưỡng không cần sửa code.
  "BusinessRules": {
    "TimeZone": "Asia/Ho_Chi_Minh",
    // BE2.6 (T21, PROPOSED – D-55): nhân sự. Vào ca sớm nhất trước giờ ca N phút (muộn nhất = hết ca + CheckInLateMinutes); đi muộn / về sớm quá ân hạn mới ghi.
    // GPS ngoài bán kính trạm bếp: false = vẫn ghi với IsValid = false + cảnh báo (HR xem lại trên bảng công), true = chặn. Trạm có tọa độ mà chưa nhập bán kính → DefaultRadiusMeters.
    // Phân ca hàng loạt / bảng công tối đa N ngày / lần; đơn nghỉ lập lùi tối đa N ngày, tối đa N ngày / đơn; lưới ca mặc định 7 ngày.
    "Hr": {
      "CheckInEarlyMinutes": 120,
      "CheckInLateMinutes": 0,
      "LateGraceMinutes": 5,
      "EarlyLeaveGraceMinutes": 5,
      "RejectOutsideRadius": false,
      "DefaultRadiusMeters": 150,
      "BulkAssignMaxDays": 31,
      "TimesheetMaxDays": 62,
      "LeaveMaxBackdateDays": 7,
      "LeaveMaxDays": 30,
      "GridDays": 7
    },
    "OrderCutoffHourPreviousDay": 20,
    "OrderLockJobTime": "20:00",
    "MrpJobTime": "20:30",
    "PurchaseProposalJobTime": "21:00",
    "StockCountVariancePctNeedApproval": 2.0,
    "PortionDeviationPctNeedApproval": 30.0,
    "TransportMinutesBeforeCutoff": 60,
    "CoreTempMinC": 70.0,
    "DeliveryTempMinC": 60.0,
    "KpiOnTimeDeliveryTargetPct": 95.0,
    "KpiIngredientToRevenueMaxPct": 55.0,
    "KpiContainerLossMaxPct": 3.0,
    "ComplaintSlaHours": { "HIGH": 4, "MEDIUM": 24, "LOW": 72 },
    "ChecklistOffsetsMinutes": { "PREP": -150, "PREP_AREA_CLEAN": -90, "BLAST_CHILL": -20, "KITCHEN_CLEAN": 90 },
    // T13: ca giao mặc định theo loại suất (MealType → Shift.Code) cho mẫu tạo đơn – PROPOSED (D-19).
    "MealTypeDefaultShift": { "SANG": "SANG_6H", "TRUA": "TRUA", "TOI": "TOI", "DEM": "DEM_23H" },
    "ExpiringLotDays": 7,
    "ShortageForecastDays": 3,
    // T14 / D-12: MRP cộng tồn an toàn vào nhu cầu (thiếu = nhu cầu + SafetyStock − khả dụng) – PROPOSED.
    "MrpIncludeSafetyStock": true,
    // T14.1 (anh chốt 2026-11-16, GAP-MRP-03): thực đơn ≥ 2 lựa chọn → chia đều số suất rồi cộng % dự phòng cho mỗi lựa chọn (0 = tắt).
    "MrpOptionBufferPct": 15,
    // T15 / T15.1 (anh chốt 2026-11-16, D-11, GAP-PUR-03 / 04 / 08): mọi PO phải duyệt (tự duyệt ≤ ngưỡng, 0 = tắt);
    // PO ≥ 50 triệu do Giám đốc duyệt (mục "#/wf-inbox?type=scm-po-director"), dưới ngưỡng "#/wf-inbox?type=scm-po"; nhận vượt tối đa 10% mỗi dòng PO;
    // nhiệt độ nhận 3 vùng theo kiểu bảo quản (≤ AcceptMax nhận; ≤ ConditionalMax nhận có điều kiện; lớn hơn loại; DRY / AMBIENT không kiểm); hạn xử lý sự cố NCC +2 ngày.
    "PurchaseOrderAutoApproveMaxAmount": 0,
    "PurchaseOrderDirectorApprovalAmount": 50000000,
    "GoodsReceiptOverReceivePct": 10,
    "ReceivingTemp": {
      "CHILLED": { "AcceptMax": 5, "ConditionalMax": 8 },
      "FROZEN": { "AcceptMax": -18, "ConditionalMax": -15, "RequireNoThawConfirmation": true }
    },
    "SupplierIssueDueDays": 2,
    // T15.1 (anh chốt 2026-11-16, phương án A – GAP-PUR-09): VAT chỉ tính khi in Đơn đặt hàng / xem chi tiết PO, không lưu DB.
    // ByIngredientCategoryCode: mã nhóm nguyên liệu (IngredientCategorie.Code) → %; không khớp thì xét nhóm cha, rồi DefaultPct.
    // Ví dụ PROPOSED – BA/PO CONFIRM (chưa bật): "ByIngredientCategoryCode": { "RAU": 5 } – rau củ tươi 5%.
    "PurchaseVat": {
      "DefaultPct": 8,
      "ByIngredientCategoryCode": {}
    },
    // T17 (PROPOSED – GAP-PRD-01 / 02): ca mặc định khi phát hành kế hoạch (Pilot: ca trưa); lịch ngược: mẻ cuối xong trước giờ xuất bếp − 30 phút chia suất / đóng gói;
    // mỗi mẻ 60 phút nếu dây chuyền chưa khai MinutesPerBatch. Ngưỡng nhiệt độ lõi = CoreTempMinC.
    // Anh chốt 2026-11-16: lưu mẫu bắt buộc TRƯỚC KHI GIAO (chặn ở DeliveryRoute/Dispatch), không phải trước khi đạt QC → false (đạt QC chỉ cảnh báo).
    "ProductionDefaultShiftCode": "TRUA",
    "ProductionPackingMinutes": 30,
    "ProductionDefaultMinutesPerBatch": 60,
    "ProductionRequireSampleBeforeRelease": false,
    // T19 (PROPOSED – GAP-DLV-03 / 05): chặn xuất chuyến khi mẻ của ngày / ca chưa đóng gói xong; chặn khi mẻ chưa lưu mẫu (anh chốt 2026-11-16);
    // cơ sở tính tiền đối soát (ORDERED / DELIVERED / ACCEPTED / SERVED); |chênh lệch| > 1% phải ghi chú khi đóng; bàn giao có suất bị từ chối → tự tạo phản ánh.
    "DeliveryRequirePackedBatches": true,
    "DeliveryRequireSampleRetained": true,
    "ReconciliationBillingBasis": "SERVED",
    "ReconciliationVarianceRemarkPct": 1.0,
    "DeliveryAutoComplaintOnRejected": true,
    // BE2.1 (PROPOSED – GAP-DLV-02): xuất phát chỉ từ chuyến Đang xếp, mọi đơn giao đã xếp lên xe (DeliveryRoute/Load). false = xuất phát thẳng từ Kế hoạch như T19.
    "DeliveryRequireLoading": true,
    // BE2.2 (PROPOSED – D-51): Order/Confirm cảnh báo + ghi nhận vào đơn khi lệch dự báo > ngưỡng (không chặn); ma trận / công bố dự báo tối đa N ngày / lần.
    "ForecastVariancePctWarning": 10.0,
    "ForecastMaxDays": 62,
    // BE2.3 (PROPOSED – D-52): duyệt nhiều cấp. ApprovalSteps: BusinessType → mục quyền duyệt từng cấp (screen-id của "#/wf-inbox?type=<id>"), có khóa thì thay
    // quy trình mặc định của handler. Mặc định (để trống): PURCHASE_REQUEST 2 cấp scm-pr-l1 → scm-pr-l2 (D-46); STOCK_COUNT 2 cấp scm-stockcount → scm-stockcount-l2
    // (spec 2.3); PURCHASE_ORDER theo ngưỡng D-11; CONTRACT, STOCK_ADJUSTMENT và loại khác 1 cấp. Ví dụ hợp đồng 2 cấp (cần thêm mục menu + quyền):
    // "ApprovalSteps": { "CONTRACT": [ "crm-contract-l1", "crm-contract" ] }.
    // Hạn mỗi cấp 48 giờ (0 = không hạn; theo loại: ApprovalStepDueHoursByType); quá hạn chỉ gắn cờ (D-45 không job), true ở ApprovalBlockOverdueDecision = chặn duyệt.
    // Một người không quyết định 2 cấp của cùng yêu cầu (admin được miễn). PO ≥ ngưỡng Giám đốc: false = 1 cấp GĐ (D-11), true = 2 cấp scm-po → scm-po-director.
    // Điều chỉnh tồn tay phải duyệt STOCK_ADJUSTMENT (mục scm-adjustment) trước khi ghi sổ; false = ghi ngay như T16.
    "ApprovalSteps": {},
    "ApprovalStepDueHours": 48,
    "ApprovalStepDueHoursByType": {},
    "ApprovalBlockOverdueDecision": false,
    "ApprovalRequireDistinctApprovers": true,
    "PurchaseOrderDirectorTwoLevel": false,
    "StockAdjustmentRequireApproval": true,
    // BE2.4 (PROPOSED – D-53): phát hành kế hoạch thì giữ chỗ nguyên liệu (MaterialReservation, phân bổ FEFO lên InventoryBalance.ReservedQuantity);
    // MRP trừ hàng sắp về từ PO Đã duyệt / Đã gửi / Nhận một phần có ngày giao dự kiến ≤ ngày SX; công đoạn theo tổ: true = mọi mẻ bắt buộc đi qua công đoạn
    // (false = chỉ kiểm mẻ đã ghi công đoạn); tổ mặc định từng công đoạn (OrganizationUnit.Code); đơn giá giờ công (0 = nhân công theo RecipeLaborCostPerServing);
    // chênh lệch tiêu hao vượt ngưỡng % → cờ isOverThreshold.
    "ProductionReserveOnRelease": true,
    "MrpIncludeIncomingPurchaseOrders": true,
    "ProductionRequireStages": false,
    "ProductionStageTeams": { "SO_CHE": "OPS-KIT-PREP", "NAU": "OPS-KIT-COOK", "COM_CANH": "OPS-KIT-RICE", "CHIA_SUAT": "OPS-KIT-PORT" },
    "ProductionLaborCostPerHour": 0,
    "ConsumptionVariancePctWarning": 5.0
  },
  // T07 / D-31: chỉ thời gian cache quyền. Quyền (kể cả duyệt) nằm trong UserRole × ObjectMenu ("Duyệt …"), admin chỉnh trên ma trận quyền.
  "Permissions": {
    "CacheMinutes": 5
  },
  // T45B.5 (GAP-F-06, Gap Register sheet 08): danh mục tham chiếu chưa có bảng – PROPOSED, BA/PO CONFIRM. API: GET api/MetaData/GetReferenceLists.
  // MealType theo BUSINESS_RULES (D-10: buổi SÁNG / TRƯA / TỐI / ĐÊM, khớp mã ca SANG_6H / TRUA / TOI / DEM_23H); Gap Register đề xuất BREAKFAST/LUNCH… (bỏ theo D-10).
  "ReferenceLists": {
    "Lists": {
      "MealType": [ { "Code": "SANG", "Label": "Sáng" }, { "Code": "TRUA", "Label": "Trưa" }, { "Code": "TOI", "Label": "Tối" }, { "Code": "DEM", "Label": "Đêm" } ],
      // BE2.6 (PROPOSED – D-55 f): loại nghỉ của đơn nghỉ (LeaveRequest.LeaveTypeCode); hình thức chấm công theo BUSINESS_RULES §10 (AttendanceEvent.SourceChannel).
      "LeaveType": [ { "Code": "ANNUAL", "Label": "Nghỉ phép năm" }, { "Code": "SICK", "Label": "Nghỉ ốm" }, { "Code": "PERSONAL", "Label": "Việc riêng (có lương)" }, { "Code": "UNPAID", "Label": "Nghỉ không lương" }, { "Code": "MATERNITY", "Label": "Thai sản" }, { "Code": "OTHER", "Label": "Khác" } ],
      "AttendanceSource": [ { "Code": "GPS", "Label": "GPS (điện thoại)" }, { "Code": "QR", "Label": "Quét QR tại bếp" }, { "Code": "MACHINE", "Label": "Máy chấm công" }, { "Code": "PROXY", "Label": "Chấm hộ" } ],
      "WarehouseType": [ { "Code": "RAW", "Label": "Nguyên liệu" }, { "Code": "FINISHED", "Label": "Thành phẩm" }, { "Code": "PACKAGING", "Label": "Bao bì" }, { "Code": "COLD", "Label": "Kho lạnh" } ],
      "StorageType": [ { "Code": "AMBIENT", "Label": "Nhiệt độ thường" }, { "Code": "CHILLED", "Label": "Mát" }, { "Code": "FROZEN", "Label": "Đông lạnh" }, { "Code": "DRY", "Label": "Khô" } ],
      "WasteType": [ { "Code": "OVERPRODUCTION", "Label": "Nấu dư" }, { "Code": "QC_REJECT", "Label": "QC loại" }, { "Code": "SPOILAGE", "Label": "Hư hỏng" }, { "Code": "PREP_LOSS", "Label": "Hao hụt sơ chế" }, { "Code": "RETURNED", "Label": "Khách trả lại" }, { "Code": "PACKING_DAMAGE", "Label": "Hỏng / loại khi đóng gói" } ],
      // BE2.1 (PROPOSED – GAP-QA-02): loại đo của nhật ký nhiệt độ tự do (TemperatureLog/Record). CORE / DELIVERY / RECEIVING ghi qua nghiệp vụ mẻ / chuyến / nhận hàng.
      "TemperatureMeasurementType": [ { "Code": "STORAGE", "Label": "Kho / tủ bảo quản" }, { "Code": "HOT_HOLDING", "Label": "Giữ nóng thành phẩm" }, { "Code": "BLAST_CHILL", "Label": "Làm lạnh nhanh" }, { "Code": "PACKING_AREA", "Label": "Khu chia suất / đóng gói" }, { "Code": "AMBIENT", "Label": "Nhiệt độ phòng" } ],
      "AdjustmentReason": [ { "Code": "COUNT_VARIANCE", "Label": "Chênh lệch kiểm kê" }, { "Code": "DAMAGED", "Label": "Hư hỏng" }, { "Code": "EXPIRED", "Label": "Hết hạn" }, { "Code": "LOST", "Label": "Thất lạc" } ],
      "ReturnInspectionResult": [ { "Code": "OK", "Label": "Đủ" }, { "Code": "SHORTAGE", "Label": "Thiếu" }, { "Code": "DAMAGED", "Label": "Hỏng" }, { "Code": "DIRTY", "Label": "Bẩn" }, { "Code": "REJECTED", "Label": "Không đạt" } ],
      "CustomerType": [ { "Code": "HOSPITAL", "Label": "Bệnh viện" }, { "Code": "SCHOOL", "Label": "Trường học" }, { "Code": "FACTORY", "Label": "Nhà máy" }, { "Code": "CONSTRUCTION", "Label": "Công trình" }, { "Code": "OTHER", "Label": "Khác" } ],
      "SupplierType": [ { "Code": "MEAT", "Label": "Thịt" }, { "Code": "VEGETABLE", "Label": "Rau củ" }, { "Code": "DRY_GOODS", "Label": "Hàng khô" }, { "Code": "PACKAGING", "Label": "Bao bì" }, { "Code": "OTHER", "Label": "Khác" } ],
      // T15: kết quả QC đầu vào theo BUSINESS_RULES §4 / D-10 (API vẫn nhận PASS / HOLD / REJECT và quy về mã dưới).
      "QcResult": [ { "Code": "DAT", "Label": "Đạt" }, { "Code": "DAT_MOT_PHAN", "Label": "Đạt một phần" }, { "Code": "KHONG_DAT", "Label": "Không đạt" } ]
    }
  },
  "SystemUsers": {
    "JobUserId": "" // T02: User dịch vụ cho job hệ thống (T23). Trống = job không được ghi.
  },
  "ApplicationInsights": {
    "QuickPulseApiKey": "" // tùy chọn
  },
  "AppSettingHelper": {
    "DomainFile": "http://localhost:5125",
    "ApiName": "App Delicare Api"
  }
}
