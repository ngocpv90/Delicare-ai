{
  "Serilog": {
    "Using": ["Serilog.Sinks.File", "Serilog.Sinks.Async"],
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level}] [{CorrelationId}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/AppDelicare.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] [{CorrelationId}] {Message}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EPPlus": {
    "ExcelPackage": {
      "LicenseContext": "Commercial" //The license context used
    }
  },
  "AllowedHosts": "*",
  // T03: origin được phép gọi API từ trình duyệt khi frontend khác domain. Angular dev dùng proxy nên không cần.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  // T01: KHÔNG ghi bí mật vào file này. Dev: dotnet user-secrets; prod: biến môi trường (Jwt__SigningKey...).
  // Xem appsettings.Development.json.example và docs/claude/SECRETS_TODO.md.
  "ConnectionStrings": {
    "MainConnectionString": "" // BẮT BUỘC – đặt trong user-secrets / biến môi trường
  },
  "JwtIssuerOptions": {
    "Issuer": "webApi",
    "Audience": "http://localhost:5125/"
  },
  "Jwt": {
    "SigningKey": "", // BẮT BUỘC – tối thiểu 32 byte, đặt trong user-secrets / biến môi trường
    "AccessTokenMinutes": 120
  },
  "Licenses": {
    "GemBox": "" // tùy chọn – trống thì GemBox chạy FREE-LIMITED
  },
  // T10: quy tắc nghiệp vụ (BUSINESS_RULES.md) – đổi ngưỡng không cần sửa code.
  "BusinessRules": {
    "TimeZone": "Asia/Ho_Chi_Minh",
    "OrderCutoffHourPreviousDay": 20,
    "OrderLockJobTime": "20:00",
    "MrpJobTime": "20:30",
    "PurchaseProposalJobTime": "21:00",
    "StockCountVariancePctNeedApproval": 2.0,
    "PortionDeviationPctNeedApproval": 30.0,
    "TransportMinutesBeforeCutoff": 60,
    "CoreTempMinC": 70.0,
    "DeliveryTempMinC": 60.0,
    "KpiOnTimeDeliveryTargetPct": 95.0,
    "KpiIngredientToRevenueMaxPct": 55.0,
    "KpiContainerLossMaxPct": 3.0,
    "ComplaintSlaHours": { "HIGH": 4, "MEDIUM": 24, "LOW": 72 },
    "ChecklistOffsetsMinutes": { "PREP": -150, "PREP_AREA_CLEAN": -90, "BLAST_CHILL": -20, "KITCHEN_CLEAN": 90 },
    // T13: ca giao mặc định theo loại suất (MealType → Shift.Code) cho mẫu tạo đơn – PROPOSED (D-19).
    "MealTypeDefaultShift": { "SANG": "SANG_6H", "TRUA": "TRUA", "TOI": "TOI", "DEM": "DEM_23H" },
    "ExpiringLotDays": 7,
    "ShortageForecastDays": 3,
    // T14 / D-12: MRP cộng tồn an toàn vào nhu cầu (thiếu = nhu cầu + SafetyStock − khả dụng) – PROPOSED.
    "MrpIncludeSafetyStock": true,
    // T15 (PROPOSED – GAP-PUR-03 / 04, D-11): tự duyệt PO ≤ ngưỡng (0 = mọi PO phải duyệt); PO > 50 triệu cần GĐ (Pilot 1 cấp – chỉ ghi chú);
    // nhận vượt tối đa 10% mỗi dòng PO; nhiệt độ nhận tối đa theo kiểu bảo quản; hạn xử lý sự cố NCC +2 ngày.
    "PurchaseOrderAutoApproveMaxAmount": 0,
    "PurchaseOrderDirectorApprovalAmount": 50000000,
    "GoodsReceiptOverReceivePct": 10,
    "ReceivingTempMaxC": { "CHILLED": 5, "FROZEN": -18 },
    "SupplierIssueDueDays": 2
  },
  // T07 / D-31: chỉ thời gian cache quyền. Quyền (kể cả duyệt) nằm trong UserRole × ObjectMenu ("Duyệt …"), admin chỉnh trên ma trận quyền.
  "Permissions": {
    "CacheMinutes": 5
  },
  // T45B.5 (GAP-F-06, Gap Register sheet 08): danh mục tham chiếu chưa có bảng – PROPOSED, BA/PO CONFIRM. API: GET api/MetaData/GetReferenceLists.
  // MealType theo BUSINESS_RULES (D-10: buổi SÁNG / TRƯA / TỐI / ĐÊM, khớp mã ca SANG_6H / TRUA / TOI / DEM_23H); Gap Register đề xuất BREAKFAST/LUNCH… (bỏ theo D-10).
  "ReferenceLists": {
    "Lists": {
      "MealType": [ { "Code": "SANG", "Label": "Sáng" }, { "Code": "TRUA", "Label": "Trưa" }, { "Code": "TOI", "Label": "Tối" }, { "Code": "DEM", "Label": "Đêm" } ],
      "WarehouseType": [ { "Code": "RAW", "Label": "Nguyên liệu" }, { "Code": "FINISHED", "Label": "Thành phẩm" }, { "Code": "PACKAGING", "Label": "Bao bì" }, { "Code": "COLD", "Label": "Kho lạnh" } ],
      "StorageType": [ { "Code": "AMBIENT", "Label": "Nhiệt độ thường" }, { "Code": "CHILLED", "Label": "Mát" }, { "Code": "FROZEN", "Label": "Đông lạnh" }, { "Code": "DRY", "Label": "Khô" } ],
      "WasteType": [ { "Code": "OVERPRODUCTION", "Label": "Nấu dư" }, { "Code": "QC_REJECT", "Label": "QC loại" }, { "Code": "SPOILAGE", "Label": "Hư hỏng" }, { "Code": "PREP_LOSS", "Label": "Hao hụt sơ chế" }, { "Code": "RETURNED", "Label": "Khách trả lại" } ],
      "AdjustmentReason": [ { "Code": "COUNT_VARIANCE", "Label": "Chênh lệch kiểm kê" }, { "Code": "DAMAGED", "Label": "Hư hỏng" }, { "Code": "EXPIRED", "Label": "Hết hạn" }, { "Code": "LOST", "Label": "Thất lạc" } ],
      "ReturnInspectionResult": [ { "Code": "OK", "Label": "Đủ" }, { "Code": "SHORTAGE", "Label": "Thiếu" }, { "Code": "DAMAGED", "Label": "Hỏng" }, { "Code": "DIRTY", "Label": "Bẩn" }, { "Code": "REJECTED", "Label": "Không đạt" } ],
      "CustomerType": [ { "Code": "HOSPITAL", "Label": "Bệnh viện" }, { "Code": "SCHOOL", "Label": "Trường học" }, { "Code": "FACTORY", "Label": "Nhà máy" }, { "Code": "CONSTRUCTION", "Label": "Công trình" }, { "Code": "OTHER", "Label": "Khác" } ],
      "SupplierType": [ { "Code": "MEAT", "Label": "Thịt" }, { "Code": "VEGETABLE", "Label": "Rau củ" }, { "Code": "DRY_GOODS", "Label": "Hàng khô" }, { "Code": "PACKAGING", "Label": "Bao bì" }, { "Code": "OTHER", "Label": "Khác" } ],
      // T15: kết quả QC đầu vào theo BUSINESS_RULES §4 / D-10 (API vẫn nhận PASS / HOLD / REJECT và quy về mã dưới).
      "QcResult": [ { "Code": "DAT", "Label": "Đạt" }, { "Code": "DAT_MOT_PHAN", "Label": "Đạt một phần" }, { "Code": "KHONG_DAT", "Label": "Không đạt" } ]
    }
  },
  "SystemUsers": {
    "JobUserId": "" // T02: User dịch vụ cho job hệ thống (T23). Trống = job không được ghi.
  },
  "ApplicationInsights": {
    "QuickPulseApiKey": "" // tùy chọn
  },
  "AppSettingHelper": {
    "DomainFile": "http://localhost:5125",
    "ApiName": "App Delicare Api"
  }
}
