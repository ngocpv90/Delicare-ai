{
  // Staging: KHÔNG ghi bí mật ở đây. Đặt bằng biến môi trường (deploy/README.md):
  //   ConnectionStrings__MainConnectionString, Jwt__SigningKey, Licenses__GemBox
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
    }
  },
  "Cors": {
    // Domain frontend staging (khi có). Để trống = không cho gọi khác origin.
    "AllowedOrigins": []
  },
  "JwtIssuerOptions": {
    "Issuer": "delicare-api-staging",
    "Audience": "delicare-staging"
  },
  "AppSettingHelper": {
    "ApiName": "App Delicare Api (STAGING)"
  }
}
