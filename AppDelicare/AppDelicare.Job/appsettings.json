{
  // T23 (D-48): cấu hình RIÊNG của AppDelicare.Job. Cấu hình nghiệp vụ (BusinessRules…) lấy từ appsettings.shared.json = appsettings.json của WebApi.
  // Bí mật KHÔNG ghi ở đây: ConnectionStrings__MainConnectionString qua biến môi trường (deploy/README.md mục Job).
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "{Timestamp:HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/AppDelicare.Job.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  // Lịch job (Jobs:<mã>) và SystemUsers:JobUserId nằm trong appsettings.json của WebApi (appsettings.shared.json) – sửa ở đó.
  "JobHost": {
    "PollSeconds": 30
  }
}
