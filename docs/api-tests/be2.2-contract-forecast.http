Content-Type: application/json

{ "customerId": "{{customerA}}", "contractId": "{{contractA}}", "deliveryLocationId": "{{locA1}}", "mealDate": "{{day}}", "note": "[DEMO]", "listLine": [ { "contractMealId": "{{mealTrua}}", "quantity": 135 } ] }

