###
POST {{base}}/api/Customer/Insert
Authorization: Bearer {{token}}
Content-Type: application/x-www-form-urlencoded

Code={{code}}B&CIF={{code}}B&Name=[DEMO] Khách B {{key}}&DisplayName=[DEMO] Khách B {{key}}&CustomerType=FACTORY&Status=Active

###
# @name cusA
GET {{base}}/api/Customer/GetAll?SearchText={{code}}A&Page=1&PageSize=5
Authorization: Bearer {{token}}

###
# @name cusB
GET {{base}}/api/Customer/GetAll?SearchText={{code}}B&Page=1&PageSize=5
Authorization: Bearer {{token}}

###
@customerA = {{cusA.response.body.listData[0].id}}
@customerB = {{cusB.response.body.listData[0].id}}

###
POST {{base}}/api/CustomerDeliveryLocation/Insert
Authorization: Bearer {{token}}
Content-Type: application/x-www-form-urlencoded

CustomerId={{customerA}}&Code={{code}}A1&Name=[DEMO] Căng tin A1 {{key}}&Address=[DEMO] Quận 1&DeliveryWindowFrom=11:00&DeliveryWindowTo=12:00&Status=Active

###
POST {{base}}/api/CustomerDeliveryLocation/Insert
Authorization: Bearer {{token}}
Content-Type: application/x-www-form-urlencoded

CustomerId={{customerA}}&Code={{code}}A2&Name=[DEMO] Căng tin A2 {{key}}&Address=[DEMO] Quận 7&DeliveryWindowFrom=11:00&DeliveryWindowTo=12:00&Status=Active

###
# @name locA1
GET {{base}}/api/CustomerDeliveryLocation/GetAll?SearchText={{code}}A1&Page=1&PageSize=5
Authorization: Bearer {{token}}

