Authorization: Bearer {{token}}
Content-Type: application/json

{ "id": "{{qcId}}", "listLine": [ { "goodsReceiptLineId": "{{grLine1}}", "result": "DAT", "temperature": 9 },
                                  { "goodsReceiptLineId": "{{grLine2}}", "result": "DAT", "temperature": 9 } ] }

