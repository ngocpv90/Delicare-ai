Authorization: Bearer {{token}}
Content-Type: application/json

{ "id": "{{qcId}}", "note": "[DEMO] QC đầu vào",
  "listLine": [ { "goodsReceiptLineId": "{{grLine1}}", "result": "DAT", "temperature": 3.5, "appearance": "Đạt", "packaging": "Nguyên" },
                { "goodsReceiptLineId": "{{grLine2}}", "result": "DAT", "temperature": 3.5, "appearance": "Đạt", "packaging": "Nguyên" } ] }

