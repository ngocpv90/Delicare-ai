# Cài đặt cho docker-compose.yml ở gốc repo (server dev). Trên server:  cp .env.example .env  rồi điền 3 dòng đánh dấu <...>.
# File ".env" KHÔNG commit (.gitignore) – mật khẩu và khóa chỉ nằm trên server.

# ---- Cổng mở ra ngoài ----
WEB_PORT=4444
API_PORT=5125

# ---- Môi trường: Staging | Production ----
APP_ENVIRONMENT=Staging

# ---- SQL Server (có sẵn bên ngoài Docker) ----
# Trong container "localhost" là chính container → luôn ghi IP / tên máy của SQL Server.
DB_SERVER=171.254.94.233
DB_NAME=Delicare
DB_ENCRYPT=False
DB_USER=<tài khoản SQL>
# Mật khẩu có ký tự đặc biệt ($ # khoảng trắng) thì đặt trong nháy đơn: DB_PASSWORD='p@$$w0rd'
DB_PASSWORD=<mật khẩu SQL>

# ---- Đồng bộ database khi "docker compose up" (deploy/db/migrate.sh) ----
# 1 = mỗi lần up: chạy migration cấu trúc bảng (DB/migrations – DB trống thì baseline 124 bảng); cập nhật stored procedure + seed còn thiếu. 0 = không đụng DB.
DB_AUTO_SYNC=1
# 1 = DB đã có bảng mà có migration MỚI (thay đổi bảng / cột) đang chờ → tự chạy (mỗi file 1 lần). 0 = dừng và in danh sách migration chờ.
# Đây là thay đổi cấu trúc DB: chỉ bật khi người phụ trách DB đồng ý.
DB_AUTO_MIGRATE=0
# 1 = backup DB (COPY_ONLY) vào thư mục backup mặc định của SQL Server trước khi migrate.
DB_BACKUP_BEFORE_MIGRATE=1
# 1 = bỏ qua migration chờ / cấu trúc thiếu, vẫn khởi động (các màn liên quan sẽ lỗi).
DB_ALLOW_SCHEMA_DRIFT=0

# ---- Ứng dụng ----
# Khóa ký JWT: chuỗi ngẫu nhiên >= 32 ký tự, mỗi môi trường một khóa riêng. Sinh bằng:  openssl rand -base64 48
JWT_SIGNING_KEY=<chuỗi ngẫu nhiên >= 32 ký tự>
# Mật khẩu tài khoản admin của ứng dụng – CHỈ dùng khi DB chưa có tài khoản admin (lần đồng bộ đầu tiên).
ADMIN_PASSWORD=
# License GemBox (để trống = chế độ FREE-LIMITED)
GEMBOX_LICENSE=

# ---- Bot Telegram (BOT-1.3, D-62) – service "messaging". Để trống = bot tắt (web / api vẫn chạy bình thường) ----
# Khóa client messaging: chuỗi ngẫu nhiên >= 32 ký tự (openssl rand -hex 32); MESSAGING_CLIENT_KEY_HASH = SHA-256 hex của nó:  printf %s "<khóa>" | sha256sum
MESSAGING_CLIENT_KEY=
MESSAGING_CLIENT_KEY_HASH=
# Khóa ký mã liên kết Telegram (>= 32 ký tự).
MESSAGING_LINK_SIGNING_KEY=
# Polling = không cần domain (server dev / test). Webhook = cần MESSAGING_WEBHOOK_BASE_URL (https) trỏ /tg/ về service messaging.
MESSAGING_MODE=Polling
MESSAGING_WEBHOOK_BASE_URL=
# Token bot lấy từ @BotFather (mỗi môi trường 1 bộ bot riêng).
TELEGRAM_VH_TOKEN=
TELEGRAM_VH_WEBHOOK_SECRET=
TELEGRAM_VH_USERNAME=
TELEGRAM_DH_TOKEN=
TELEGRAM_DH_WEBHOOK_SECRET=
TELEGRAM_DH_USERNAME=

# --- Trợ lý AI (AI-24, D-142 b) – toolgateway + Hermes (profile "hermes"). Trống = agent / bot Trợ lý chưa bật. KHÔNG dùng lại giá trị môi trường khác ---
# Khóa từng agent: chuỗi ngẫu nhiên ≥ 32 ký tự, sinh: openssl rand -hex 32 (mỗi agent 1 khóa riêng). Cùng giá trị cho api, toolgateway và container Hermes của nhóm agent đó.
AGENT_KEY_VIVI=
AGENT_KEY_KNOW=
AGENT_KEY_KITCHEN=
AGENT_KEY_QA=
AGENT_KEY_LOG=
AGENT_KEY_PKG=
AGENT_KEY_WH=
AGENT_KEY_SALES=
AGENT_KEY_PLAN=
AGENT_KEY_PROC=
AGENT_KEY_HR=
AGENT_KEY_ACC=
AGENT_KEY_CSKH=
# Khóa API server Hermes (api gọi chat web bằng Bearer): openssl rand -hex 32
HERMES_API_KEY=
# Khóa mô hình (Anthropic) – chỉ container Hermes dùng.
ANTHROPIC_API_KEY=
# Token bot Telegram Trợ lý (bộ bot TEST / PROD riêng, tạo bằng @BotFather) – chỉ container hermes-vivi dùng. Bật bot + đặt tên bot ở Trung tâm Agent › Bot Trợ lý.
TELEGRAM_BOT_TOKEN_TRO_LY=
# Mô hình: chat / câu hỏi (mặc định) và việc theo lịch mode "ai" (rẻ hơn).
HERMES_MODEL_DEFAULT=claude-sonnet-5-5
HERMES_MODEL_SCHEDULED=claude-haiku-5-5
# Ngân sách chi phí AI / tháng (VND) – cảnh báo 80 % và 100 %; trống = không cảnh báo.
AGENT_MONTHLY_BUDGET=

# AI-25.3: địa chỉ web người dùng (https://…) cho nút 🌐 Mở trên web của 💬 Hỏi nhanh trên bot; trống = không có nút.
WEB_URL=
