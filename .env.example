# Mẫu cho docker-compose.yml ở gốc repo. Sao chép thành ".env" rồi điền – ".env" KHÔNG commit (.gitignore).

# Cổng mở ra ngoài của server
WEB_PORT=4444
API_PORT=5125

# Staging | Production
APP_ENVIRONMENT=Staging

# Chuỗi kết nối SQL Server (DB có sẵn bên ngoài Docker)
DB_CONNECTION=Server=<host,1433>;Database=<tên DB>;User Id=<user>;Password=<mật khẩu>;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Khóa ký JWT: chuỗi ngẫu nhiên >= 32 ký tự, mỗi môi trường một khóa riêng
JWT_SIGNING_KEY=<chuỗi ngẫu nhiên >= 32 ký tự>

# Tùy chọn: license GemBox (để trống = chế độ FREE-LIMITED)
GEMBOX_LICENSE=
