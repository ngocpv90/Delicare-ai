# Sao chép thành staging.env (KHÔNG commit – .gitignore) rồi điền. Không dùng lại giá trị ở môi trường khác.
SA_PASSWORD=<mật khẩu SA mạnh: >= 8 ký tự, có hoa, thường, số, ký tự đặc biệt>
DB_NAME=AppDelicare
ADMIN_PASSWORD=<mật khẩu tài khoản admin của app – đổi sau lần đăng nhập đầu>
JWT_SIGNING_KEY=<chuỗi ngẫu nhiên >= 32 byte, vd. base64 64 byte>
GEMBOX_LICENSE=
# T48.4 (D-60): tài khoản SQL riêng cho api / job (db-init tạo; đọc / ghi / EXECUTE, không DDL). Bỏ trống = api / job dùng sa như cũ.
APP_DB_USER=delicare_app
APP_DB_PASSWORD=<mật khẩu ASCII >= 12 ký tự>
APP_DB_RESET_PASSWORD=0

# --- Bot Telegram (BOT-1.3, D-62) – container messaging. Bộ bot TEST tạo bằng @BotFather; trống = bot tắt ---
# Khóa client messaging (chuỗi ngẫu nhiên ≥ 32 ký tự) + SHA-256 hex của nó (Linux: printf %s "<khóa>" | sha256sum).
MESSAGING_CLIENT_KEY=
MESSAGING_CLIENT_KEY_HASH=
# Khóa ký mã liên kết (≥ 32 ký tự, openssl rand -hex 32).
MESSAGING_LINK_SIGNING_KEY=
# Polling (mặc định – không cần domain) | Webhook (cần MESSAGING_WEBHOOK_BASE_URL https + nginx /tg/ → messaging).
MESSAGING_MODE=Polling
MESSAGING_WEBHOOK_BASE_URL=
TELEGRAM_VH_TOKEN=
TELEGRAM_VH_WEBHOOK_SECRET=
TELEGRAM_VH_USERNAME=
TELEGRAM_DH_TOKEN=
TELEGRAM_DH_WEBHOOK_SECRET=
TELEGRAM_DH_USERNAME=

# --- Trợ lý AI (AI-24, D-142 b) – toolgateway + Hermes (profile "hermes"). Trống = agent / bot Trợ lý chưa bật. KHÔNG dùng lại giá trị môi trường khác ---
# Khóa từng agent: chuỗi ngẫu nhiên ≥ 32 ký tự, sinh: openssl rand -hex 32 (mỗi agent 1 khóa riêng). Cùng giá trị cho api, toolgateway và container Hermes của nhóm agent đó.
AGENT_KEY_VIVI=
AGENT_KEY_KNOW=
AGENT_KEY_KITCHEN=
AGENT_KEY_QA=
AGENT_KEY_LOG=
AGENT_KEY_PKG=
AGENT_KEY_WH=
AGENT_KEY_SALES=
AGENT_KEY_PLAN=
AGENT_KEY_PROC=
AGENT_KEY_HR=
AGENT_KEY_ACC=
AGENT_KEY_CSKH=
# Khóa API server Hermes (api gọi chat web bằng Bearer): openssl rand -hex 32
HERMES_API_KEY=
# Khóa mô hình (Anthropic) – chỉ container Hermes dùng.
ANTHROPIC_API_KEY=
# Token bot Telegram Trợ lý (bộ bot TEST / PROD riêng, tạo bằng @BotFather) – chỉ container hermes-vivi dùng. Bật bot + đặt tên bot ở Trung tâm Agent › Bot Trợ lý.
TELEGRAM_BOT_TOKEN_TRO_LY=
# Mô hình: chat / câu hỏi (mặc định) và việc theo lịch mode "ai" (rẻ hơn).
HERMES_MODEL_DEFAULT=claude-sonnet-5-5
HERMES_MODEL_SCHEDULED=claude-haiku-5-5
# Ngân sách chi phí AI / tháng (VND) – cảnh báo 80 % và 100 %; trống = không cảnh báo.
AGENT_MONTHLY_BUDGET=

# AI-25.3: địa chỉ web người dùng (https://…) cho nút 🌐 Mở trên web của 💬 Hỏi nhanh trên bot; trống = không có nút.
WEB_URL=
