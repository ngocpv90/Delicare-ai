# DELICARE production (T48.4, D-60) – sao chép thành production.env TRÊN SERVER rồi điền. KHÔNG commit production.env (.gitignore).
# Không dùng lại giá trị của staging / dev.

# --- SQL Server (riêng, có TZ=Asia/Ho_Chi_Minh – deploy/README.md) ---
DB_SERVER=<host,1433>
DB_NAME=AppDelicare
DB_ENCRYPT=True
DB_TRUST_CERT=False
# Tài khoản quản trị SQL – CHỈ dùng cho db-init (tạo SP / seed / tài khoản ứng dụng)
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=<mật khẩu quản trị SQL>
# Tài khoản ứng dụng cho api / job (db-init tạo: đọc / ghi / EXECUTE, không DDL). Mật khẩu ASCII >= 12 ký tự.
APP_DB_USER=delicare_app
APP_DB_PASSWORD=<mật khẩu mạnh, chỉ ASCII>
APP_DB_RESET_PASSWORD=0

# --- Ứng dụng ---
ADMIN_PASSWORD=<mật khẩu admin app lần đầu – đổi sau khi đăng nhập>
JWT_SIGNING_KEY=<chuỗi ngẫu nhiên >= 32 byte>
GEMBOX_LICENSE=
IOT_API_KEY_0=
IOT_API_KEY_1=

# --- Web ---
SERVER_NAME=<domain, vd. delicare.example.vn>
PUBLIC_ORIGIN=https://<domain>
MAX_UPLOAD_MB=25
