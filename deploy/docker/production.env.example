# DELICARE production (T48.4, D-60) – sao chép thành production.env TRÊN SERVER rồi điền. KHÔNG commit production.env (.gitignore).
# Không dùng lại giá trị của staging / dev.

# --- SQL Server (riêng, có TZ=Asia/Ho_Chi_Minh – deploy/README.md) ---
DB_SERVER=<host,1433>
DB_NAME=AppDelicare
DB_ENCRYPT=True
DB_TRUST_CERT=False
# Tài khoản quản trị SQL – CHỈ dùng cho db-init (tạo SP / seed / tài khoản ứng dụng)
DB_ADMIN_USER=sa
DB_ADMIN_PASSWORD=<mật khẩu quản trị SQL>
# Tài khoản ứng dụng cho api / job (db-init tạo: đọc / ghi / EXECUTE, không DDL). Mật khẩu ASCII >= 12 ký tự.
APP_DB_USER=delicare_app
APP_DB_PASSWORD=<mật khẩu mạnh, chỉ ASCII>
APP_DB_RESET_PASSWORD=0

# --- Ứng dụng ---
ADMIN_PASSWORD=<mật khẩu admin app lần đầu – đổi sau khi đăng nhập>
JWT_SIGNING_KEY=<chuỗi ngẫu nhiên >= 32 byte>
GEMBOX_LICENSE=
IOT_API_KEY_0=
IOT_API_KEY_1=
# BOT-1.1: SHA-256 hex (chữ HOA hoặc thường) của khóa client messaging – Linux: printf %s "<khóa>" | sha256sum ; khóa gốc đặt cho container messaging (BOT-1.3)
MESSAGING_CLIENT_KEY_HASH=
# BOT-1.2: khóa ký mã liên kết Telegram (chuỗi ngẫu nhiên ≥ 32 ký tự, vd. openssl rand -hex 32)
MESSAGING_LINK_SIGNING_KEY=

# --- Bot Telegram (BOT-1.3, D-62) – container messaging. Bộ bot PROD tạo bằng @BotFather; trống = bot tắt ---
# Khóa client messaging (chuỗi ngẫu nhiên ≥ 32 ký tự); MESSAGING_CLIENT_KEY_HASH ở trên = SHA-256 hex của chính khóa này.
MESSAGING_CLIENT_KEY=
TELEGRAM_VH_TOKEN=
TELEGRAM_VH_WEBHOOK_SECRET=
TELEGRAM_VH_USERNAME=
TELEGRAM_DH_TOKEN=
TELEGRAM_DH_WEBHOOK_SECRET=
TELEGRAM_DH_USERNAME=

# --- Web ---
SERVER_NAME=<domain, vd. delicare.example.vn>
PUBLIC_ORIGIN=https://<domain>
MAX_UPLOAD_MB=25

# --- Trợ lý AI (AI-24, D-142 b) – toolgateway + Hermes (profile "hermes"). Trống = agent / bot Trợ lý chưa bật. KHÔNG dùng lại giá trị môi trường khác ---
# Khóa từng agent: chuỗi ngẫu nhiên ≥ 32 ký tự, sinh: openssl rand -hex 32 (mỗi agent 1 khóa riêng). Cùng giá trị cho api, toolgateway và container Hermes của nhóm agent đó.
AGENT_KEY_VIVI=
AGENT_KEY_KNOW=
AGENT_KEY_KITCHEN=
AGENT_KEY_QA=
AGENT_KEY_LOG=
AGENT_KEY_PKG=
AGENT_KEY_WH=
AGENT_KEY_SALES=
AGENT_KEY_PLAN=
AGENT_KEY_PROC=
AGENT_KEY_HR=
AGENT_KEY_ACC=
AGENT_KEY_CSKH=
# Khóa API server Hermes (api gọi chat web bằng Bearer): openssl rand -hex 32
HERMES_API_KEY=
# Khóa mô hình (Anthropic) – chỉ container Hermes dùng.
ANTHROPIC_API_KEY=
# Token bot Telegram Trợ lý (bộ bot TEST / PROD riêng, tạo bằng @BotFather) – chỉ container hermes-vivi dùng. Bật bot + đặt tên bot ở Trung tâm Agent › Bot Trợ lý.
TELEGRAM_BOT_TOKEN_TRO_LY=
# Mô hình: chat / câu hỏi (mặc định) và việc theo lịch mode "ai" (rẻ hơn).
HERMES_MODEL_DEFAULT=claude-sonnet-5-5
HERMES_MODEL_SCHEDULED=claude-haiku-5-5
# Ngân sách chi phí AI / tháng (VND) – cảnh báo 80 % và 100 %; trống = không cảnh báo.
AGENT_MONTHLY_BUDGET=
